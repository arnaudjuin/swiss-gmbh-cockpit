# Copy this file to .env.local and adjust as needed:  cp .env.example .env.local

# --- Core ---
# Login password checked by the server. The demo ships with "demo".
ADMIN_PASSWORD=demo
# Session lifetime in seconds (default 86400 = 24h).
SESSION_TTL=86400

# --- Storage ---
# SQLite database file. `npm run seed` creates ./data/demo.db.
DB_PATH=./data/demo.db
# Uploaded documents (bill/invoice scans, statement PDFs) live here.
DOCS_DIR=./data/documents
# Markdown docs shown in the in-app viewer / knowledge base.
DOCS_MD_DIR=./docs

# --- AI chat (all optional; the app runs fine without any of these) ---
# Provider: "ollama" (default, local), "anthropic", or "openai".
LLM_PROVIDER=ollama
# Ollama (local, no key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
# Anthropic (set the key to enable)
# ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514
# OpenAI (set the key to enable)
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
