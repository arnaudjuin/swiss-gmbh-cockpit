# Authentication
ADMIN_PASSWORD=your-secure-password-here

# Session duration (seconds, default 24h)
SESSION_TTL=86400

# Server binding
HOST=0.0.0.0
PORT=8000

# Set to true when behind HTTPS reverse proxy
SECURE_COOKIES=false

# Anthropic API key (for AI receipt scanning)
ANTHROPIC_API_KEY=sk-ant-...
